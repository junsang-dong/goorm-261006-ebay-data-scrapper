# 서버 비밀값은 로컬 .env.local 과 Vercel Preview/Production 환경에 각각 설정한다.
# 실제 값은 이 파일에 넣지 않는다. VITE_ 접두사를 붙이지 않는다.

DATABASE_URL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=
DATA_MODE=mock
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_SPORTS_CATEGORY_IDS=
EBAY_DAILY_BUDGET=500
LIVE_CACHE_TTL_SECONDS=18000
ENABLE_LIVE_EXPORT=false
# Apify 실행 연동 (SPEC 3.4). 기본 비활성. 현재 코드에는 실행 연동이 아직 없고, 파일 가져오기만 동작합니다.
APIFY_ENABLED=false
